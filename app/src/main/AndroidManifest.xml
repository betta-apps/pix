<?xml version="1.0" encoding="utf-8"?>
<!-- Pix: the screensaver, its preview, the Plex sign-in, and the screen its icon opens. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <!-- No backup: the Plex sign-in stays on this TV, not in a Google backup. -->
    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <activity
            android:name=".PixActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The screensaver as a screen: opened from Settings, and where you sign in to Plex. -->
        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <service
            android:name=".PixDream"
            android:exported="true"
            android:label="@string/dream_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Where the TV's screen saver list sends you to change Pix's settings. -->
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/dream" />
        </service>
    </application>
</manifest>
